# Copie este arquivo para .env e preencha os valores. O .env NÃO deve ser commitado.

# Chave usada para assinar os tokens JWT. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Algoritmo de assinatura do JWT
ALGORITHM=HS256

# Validade do access token, em minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# (opcional) Desconto máximo, em %, que um vendedor comum pode aplicar. Padrão: 10
MAX_DISCOUNT_SELLER=10
